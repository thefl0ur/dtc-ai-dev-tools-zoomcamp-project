server {
    listen 80;
    server_name localhost;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to the backend
    location /api/ {
        # Check for potential loop by looking for our own forwarded-by header
        if ($http_x_forwarded_by = "nginx") {
            return 400 "Bad Request - Possible loop detected";
        }

        # Remove /api prefix before sending to backend
        rewrite ^/api/(.*) /$1 break;
        proxy_pass $VUE_APP_API_URL;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        # Set Host header to the backend host
        proxy_set_header Host $VUE_APP_API_URL_HOST;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_redirect off;

        # Add a header to mark that this request has been proxied by nginx
        proxy_set_header X-Forwarded-By nginx;
    }
}