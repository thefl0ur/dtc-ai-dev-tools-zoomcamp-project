{
  "mcpServers": {
    "github": {
      "httpUrl": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer $GITHUB_TOKEN",
        "X-MCP-Toolsets": "all"
      },
      "timeout": 3000
    },
    "render": {
      "httpUrl": "https://mcp.render.com/mcp",
      "headers": {
        "Authorization": "Bearer $RENDER_TOKEN"
      },
      "timeout": 10000
    }
  },
  "$version": 2
}
